<ResourceDictionary
    x:Class="ArnoldVinkStyles.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AVStyles="using:ArnoldVinkStyles">

    <!-- Style Variables -->
    <x:Double x:Key="ApplicationPanelSize">110</x:Double>
    <x:Double x:Key="ApplicationImageHeight">100</x:Double>
    <x:Double x:Key="ApplicationImageMaxWidth">80</x:Double>
    <x:Double x:Key="MediaImageHeight">200</x:Double>

    <!-- ListViewItemSettings -->
    <DataTemplate x:Key="ListViewItemSettings">
        <Grid Margin="5" Height="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="{Binding ImageBitmap}" Width="50" Height="50"/>
            <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource TextBlockWhite}" FontSize="{StaticResource TextSizeMedium}" TextAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemAppCategory -->
    <DataTemplate x:Key="ListViewItemAppCategory">
        <Grid Margin="5" Width="120">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="{Binding ImageBitmap}" Width="50" Height="50"/>
            <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource TextBlockWhite}" FontSize="{StaticResource TextSizeMedium}" TextAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemApp -->
    <DataTemplate x:Key="ListViewItemApp">
        <Grid Width="{ThemeResource ApplicationPanelSize}" MinHeight="{ThemeResource ApplicationPanelSize}" Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border CornerRadius="10" Background="{ThemeResource ApplicationWhiteBrush}" Visibility="{Binding LightImageBackground, Converter={AVStyles:BoolToVisibilityConverter}}"/>
                <Image Source="{Binding ImageBitmap}" Height="{ThemeResource ApplicationImageHeight}" MaxWidth="{ThemeResource ApplicationImageMaxWidth}"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal" Height="12" Margin="0,5,0,0">
                <Ellipse Height="12" Width="12" VerticalAlignment="Center" Margin="2,0,2,0" Fill="{ThemeResource ApplicationAccentLightBrush}" Opacity="0.90" Visibility="{Binding StatusRunning}"/>
                <Ellipse Height="12" Width="12" VerticalAlignment="Center" Margin="2,0,2,0" Fill="#EE8F3F" Opacity="0.90" Visibility="{Binding StatusSuspended}"/>
                <Ellipse Height="12" Width="12" VerticalAlignment="Center" Margin="2,0,2,0" Fill="#FF3000" Opacity="0.90" Visibility="{Binding StatusNotResponding}"/>
                <Path Height="12" Width="12" VerticalAlignment="Center" Margin="2,0,2,0" Data="M0,0 L1,1 M0,1 L1,0" Stretch="Fill" Stroke="#CD1928" StrokeThickness="3" Opacity="0.90" Visibility="{Binding StatusAvailable}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="/Assets/Default/Apps/Microsoft.png" Opacity="0.90" Visibility="{Binding StatusStore}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="/Assets/Default/Icons/Browser.png" Opacity="0.90" Visibility="{Binding StatusUrlBrowser}"/>
                <Polygon VerticalAlignment="Center" Margin="2,0,2,0" Fill="#1EB955" Points="0,0 12,6, 0,12" Opacity="0.90" Visibility="{Binding StatusUrlProtocol}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="{Binding StatusLauncherImage}" Opacity="0.90" Visibility="{Binding StatusLauncherImage, Converter={AVStyles:NullToVisibilityConverter}}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="{Binding StatusEmulatorCategoryImage}" Opacity="0.90" Visibility="{Binding StatusEmulatorCategoryImage, Converter={AVStyles:NullToVisibilityConverter}}"/>
                <TextBlock VerticalAlignment="Center" Margin="2,0,2,0" Text="{Binding StatusProcessCount}" FontSize="{ThemeResource TextSizeTiny}" FontWeight="SemiBold" Style="{StaticResource TextBlockWhite}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Style="{StaticResource ScrollViewerHiddenLoop}">
                <TextBlock Text="{Binding Name}" Style="{StaticResource TextBlockWhite}"/>
            </ScrollViewer>

            <ScrollViewer Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Style="{StaticResource ScrollViewerHiddenLoop}">
                <TextBlock Text="{Binding EmulatorName}" Style="{StaticResource TextBlockGray}"/>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemSearch -->
    <DataTemplate x:Key="ListViewItemSearch">
        <Grid Width="{ThemeResource ApplicationPanelSize}" MinHeight="{ThemeResource ApplicationPanelSize}" Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Border CornerRadius="10" Background="{ThemeResource ApplicationWhiteBrush}" Visibility="{Binding LightImageBackground, Converter={AVStyles:BoolToVisibilityConverter}}"/>
                <Image Source="{Binding ImageBitmap}" Height="{ThemeResource ApplicationImageHeight}" MaxWidth="{ThemeResource ApplicationImageMaxWidth}"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal" Height="12" Margin="0,5,0,0">
                <Ellipse Height="12" Width="12" VerticalAlignment="Center" Margin="2,0,2,0" Fill="{ThemeResource ApplicationAccentLightBrush}" Opacity="0.90" Visibility="{Binding StatusRunning}"/>
                <Ellipse Height="12" Width="12" VerticalAlignment="Center" Margin="2,0,2,0" Fill="#EE8F3F" Opacity="0.90" Visibility="{Binding StatusSuspended}"/>
                <Ellipse Height="12" Width="12" VerticalAlignment="Center" Margin="2,0,2,0" Fill="#FF3000" Opacity="0.90" Visibility="{Binding StatusNotResponding}"/>
                <Path Height="12" Width="12" VerticalAlignment="Center" Margin="2,0,2,0" Data="M0,0 L1,1 M0,1 L1,0" Stretch="Fill" Stroke="#CD1928" StrokeThickness="3" Opacity="0.90" Visibility="{Binding StatusAvailable}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="/Assets/Default/Apps/Microsoft.png" Opacity="0.90" Visibility="{Binding StatusStore}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="/Assets/Default/Icons/Browser.png" Opacity="0.90" Visibility="{Binding StatusUrlBrowser}"/>
                <Polygon VerticalAlignment="Center" Margin="2,0,2,0" Fill="#1EB955" Points="0,0 12,6, 0,12" Opacity="0.90" Visibility="{Binding StatusUrlProtocol}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="{Binding StatusLauncherImage}" Opacity="0.90" Visibility="{Binding StatusLauncherImage, Converter={AVStyles:NullToVisibilityConverter}}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="{Binding StatusEmulatorCategoryImage}" Opacity="0.90" Visibility="{Binding StatusEmulatorCategoryImage, Converter={AVStyles:NullToVisibilityConverter}}"/>
                <Image Height="12" VerticalAlignment="Center" Margin="2,0,2,0" Source="{Binding StatusSearchCategoryImage}" Opacity="0.90" Visibility="{Binding StatusSearchCategoryImage, Converter={AVStyles:NullToVisibilityConverter}}"/>
                <TextBlock VerticalAlignment="Center" Margin="2,0,2,0" Text="{Binding StatusProcessCount}" FontSize="{ThemeResource TextSizeTiny}" FontWeight="SemiBold" Style="{StaticResource TextBlockWhite}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Style="{StaticResource ScrollViewerHiddenLoop}">
                <TextBlock Text="{Binding Name}" Style="{StaticResource TextBlockWhite}"/>
            </ScrollViewer>

            <ScrollViewer Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Style="{StaticResource ScrollViewerHiddenLoop}">
                <TextBlock Text="{Binding EmulatorName}" Style="{StaticResource TextBlockGray}"/>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemGallery -->
    <DataTemplate x:Key="ListViewItemGallery">
        <Grid Margin="2">
            <Border CornerRadius="4" Height="180" Width="240" MaxHeight="{ThemeResource MediaImageHeight}">
                <Border.Background>
                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding ImageBitmap}"/>
                </Border.Background>
            </Border>

            <Border Visibility="{Binding StatusVideo}" MinWidth="25" MinHeight="25" CornerRadius="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource ApplicationDarkGrayColor}" Opacity="0.90"/>
                </Border.Background>
                <Image Height="20" Source="/Assets/Default/Icons/Play.png"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemContentScreenshot -->
    <DataTemplate x:Key="ListViewItemContentScreenshot">
        <Border Margin="2" CornerRadius="4" Height="135" Width="240">
            <Border.Background>
                <ImageBrush Stretch="UniformToFill" ImageSource="{Binding}"/>
            </Border.Background>
        </Border>
    </DataTemplate>

    <!-- ListViewItemFile -->
    <DataTemplate x:Key="ListViewItemFile">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Image Source="{Binding ImageBitmap}" Height="50" Width="50"/>
                <Image Source="/Assets/Default/Icons/Copy.png" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="30" Opacity="0.90" Visibility="{Binding ClipboardType, ConverterParameter='Copy', Converter={AVStyles:MatchToVisibilityConverter}}"/>
                <Image Source="/Assets/Default/Icons/Cut.png" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="30" Opacity="0.90" Visibility="{Binding ClipboardType, ConverterParameter='Cut', Converter={AVStyles:MatchToVisibilityConverter}}"/>
                <Image Source="/Assets/Default/Icons/Check.png" Visibility="{Binding Checked}" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="30" Opacity="0.90"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" Style="{StaticResource ScrollViewerHiddenLoop}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock>
                    <Run Text="{Binding Name}" Foreground="{ThemeResource ApplicationWhiteBrush}" FontWeight="Light" FontSize="{StaticResource TextSizeHuge}"/>
                    <Run Text="{Binding NameSub}" Foreground="{ThemeResource ApplicationDimGrayBrush}" FontWeight="Light" FontSize="{StaticResource TextSizeHuge}"/>
                </TextBlock>
            </ScrollViewer>

            <TextBlock Grid.Column="2" Text="{Binding NameDetail}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Margin="10,0,5,0" Style="{StaticResource TextBlockAccentLight}" FontSize="{ThemeResource TextSizeHuge}"/>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemString -->
    <DataTemplate x:Key="ListViewItemString">
        <TextBlock Margin="8,4,8,4" Text="{Binding String1}" VerticalAlignment="Center" Style="{StaticResource TextBlockWhiteLight}" FontSize="{ThemeResource TextSizeHuge}"/>
    </DataTemplate>

    <!-- ListViewItemIconString -->
    <DataTemplate x:Key="ListViewItemIconString">
        <Grid Margin="5,10,5,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="{Binding ImageBitmap}" Height="50" Width="50" VerticalAlignment="Center" HorizontalAlignment="Left"/>

            <ScrollViewer Grid.Column="1" Style="{StaticResource ScrollViewerHiddenLoop}" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock>
                    <Run Text="{Binding Name}" Foreground="{ThemeResource ApplicationWhiteBrush}" FontWeight="Light" FontSize="{StaticResource TextSizeHuge}"/>
                    <Run Text="{Binding NameSub}" Foreground="{ThemeResource ApplicationDimGrayBrush}" FontWeight="Light" FontSize="{StaticResource TextSizeHuge}"/>
                </TextBlock>
            </ScrollViewer>

            <TextBlock Grid.Column="3" Text="{Binding NameDetail}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Margin="10,0,5,0" Style="{StaticResource TextBlockAccentLight}" FontSize="{ThemeResource TextSizeHuge}"/>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemLauncherToggle -->
    <DataTemplate x:Key="ListViewItemLauncherToggle">
        <Grid Height="100" Width="100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="{Binding ImageBitmap}" Width="60" Height="60"/>
            <CheckBox Grid.Row="1" HorizontalAlignment="Center" Tag="{Binding Name}" IsHitTestVisible="False" IsTabStop="False" IsChecked="{Binding Enabled}" Style="{StaticResource CheckBoxWhite}"/>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemHowLongToBeat -->
    <DataTemplate x:Key="ListViewItemHowLongToBeat">
        <Grid Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" Margin="0,0,20,0" MinWidth="350" MaxWidth="650" Style="{StaticResource ScrollViewerHiddenLoop}">
                <TextBlock Text="{Binding Data1}" Style="{StaticResource TextBlockWhiteLight}" FontSize="{ThemeResource TextSizeLarge}"/>
            </ScrollViewer>
            <TextBlock Grid.Column="1" Margin="0,0,20,0" Text="{Binding Data2}" Style="{StaticResource TextBlockAccentLight}" FontSize="{ThemeResource TextSizeLarge}"/>
            <TextBlock Grid.Column="2" Margin="0,0,20,0" Text="{Binding Data3}" Style="{StaticResource TextBlockWhiteLight}" FontSize="{ThemeResource TextSizeLarge}"/>
            <TextBlock Grid.Column="3" Margin="0,0,20,0" Text="{Binding Data4}" Style="{StaticResource TextBlockAccentLight}" FontSize="{ThemeResource TextSizeLarge}"/>
            <TextBlock Grid.Column="4" Margin="0,0,20,0" Text="{Binding Data5}" Style="{StaticResource TextBlockWhiteLight}" FontSize="{ThemeResource TextSizeLarge}"/>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemProfile -->
    <DataTemplate x:Key="ListViewItemProfile">
        <Grid Margin="5" ToolTipService.ToolTip="Remove profile value">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding String1}" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource TextBlockWhiteLight}" FontSize="{ThemeResource TextSizeHuge}"/>
            <TextBlock Grid.Column="1" Text="{Binding String2}" VerticalAlignment="Center" Margin="5,0,0,0" Style="{StaticResource TextBlockGrayLight}" FontSize="{ThemeResource TextSizeHuge}"/>
            <Image Grid.Column="2" Source="/Assets/Default/Icons/RemoveCross.png" Height="40" Width="40"/>
        </Grid>
    </DataTemplate>

    <!-- ListViewItemColor -->
    <DataTemplate x:Key="ListViewItemColor">
        <Border CornerRadius="2" Background="{Binding}" Width="70" Height="70"/>
    </DataTemplate>

    <!-- ListViewItemRom -->
    <DataTemplate x:Key="ListViewItemRom">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Image Source="{Binding ImageBitmap}" Width="170" Height="115"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Image Source="/Assets/Default/Icons/Folder.png" Margin="10,0,0,0" Height="30" Width="30" Opacity="0.90" Visibility="{Binding FileType, ConverterParameter='Folder', Converter={AVStyles:MatchToVisibilityConverter}}"/>
                    <Image Source="/Assets/Default/Icons/Link.png" Margin="10,0,0,0" Height="30" Width="30" Opacity="0.90" Visibility="{Binding IsShortcut, Converter={AVStyles:BoolToVisibilityConverter}}"/>
                    <Image Source="/Assets/Default/Icons/Copy.png" Margin="10,0,0,0" Height="30" Width="30" Opacity="0.90" Visibility="{Binding ClipboardType, ConverterParameter='Copy', Converter={AVStyles:MatchToVisibilityConverter}}"/>
                    <Image Source="/Assets/Default/Icons/Cut.png" Margin="10,0,0,0" Height="30" Width="30" Opacity="0.90" Visibility="{Binding ClipboardType, ConverterParameter='Cut', Converter={AVStyles:MatchToVisibilityConverter}}"/>
                    <Image Source="/Assets/Default/Icons/Check.png" Visibility="{Binding Checked}" Margin="10,0,0,0" Height="30" Width="30" Opacity="0.90"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Width="170" Height="55" ScrollViewer.VerticalScrollBarVisibility="Hidden" IsHitTestVisible="False" Style="{StaticResource ScrollViewerVerticalLoop}">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                    <Run Text="{Binding Name}" Foreground="{ThemeResource ApplicationWhiteBrush}" FontSize="{StaticResource TextSizeMedium}"/>
                    <Run Text="{Binding NameSub}" Foreground="{ThemeResource ApplicationDimGrayBrush}" FontSize="{StaticResource TextSizeMedium}"/>
                </TextBlock>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>